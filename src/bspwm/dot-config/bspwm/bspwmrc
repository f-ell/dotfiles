#!/bin/bash
#  ____   ____
#  |   \  |  |______
#  |    \ |  | ___  \
#  |     \|  | |  \  |
#  |  \   \  | |__/  |
#  |  |\     | _____/
#  |__| \____| | Author: Nico Pareigis
#           |__| bspwm

bspc desktop any -r
bspc rule -r *
ps -o pid= -C 'bspc subscribe' | xargs kill

# CONFIG
bspc monitor eDP1 -d 1 2 3 4 5 6
bspc config pointer_motion_interval 16
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true

bspc config window_gap      16
bspc config border_width    2
bspc config split_ratio     0.50
bspc config top_padding     0
bspc config right_padding   0
bspc config bottom_padding  0
bspc config left_padding    0

bspc config single_monocle          false
bspc config pointer_modifier        mod4
bspc config pointer_action1         move
bspc config pointer_action2         none
bspc config pointer_action3         resize_corner
bspc config click_to_focus          button1
bspc config focus_follows_pointer   true
bspc config pointer_follows_focus   false
bspc config pointer_follows_monitor false

bspc config focused_border_color  '#8da101'
bspc config active_border_color   '#323d43'
bspc config normal_border_color   '#323d43'
bspc config presel_feedback_color '#8da101'

# RULES
bspc rule -a Gimp                   state=floating
bspc rule -a *:*:Picture-in-Picture state=floating

# AUTOSTART
dbus-update-activation-environment --all & # Pass WM environment to DBus. Required to unlock Gnome keyring.
pgrep eww || eww daemon &
eww open bar-bspwm

pgrep dunst || dunst &
pgrep sxhkd || sxhkd "$XDG_CONFIG_HOME"/sxhkd/sxhkdrc "$XDG_CONFIG_HOME"/bspwm/sxhkdrc.bspwm &
pgrep ssm || ssm -t 60 -e c,g -b 30 &

[[ -f $WALLPAPER ]] && feh --no-fehbg --bg-center "$WALLPAPER" || :

pgrep monitor     || "$XDG_CONFIG_HOME"/bspwm/scripts/monitor &
pgrep floatdesk   || "$XDG_CONFIG_HOME"/bspwm/scripts/floatdesk `bspc query -D -d '^6'` &
pgrep dynamic_bar || "$XDG_CONFIG_HOME"/bspwm/scripts/dynamic_bar &
