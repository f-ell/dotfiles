(defwindow bar-bspwm
    :monitor '["<primary", 0]'
    :geometry (geometry
        :x 0
        :y 0
        :width '100%'
        :height 32
        :anchor 'top center'
    )
    :wm-ingore false
    :reserve (struts :distance 32 :side 'top')
    (centerbox
        :orientation 'h'
        :class 'bar'
        (box
            :space-evenly false
            :halign 'start'
            (bspwm-desktops)
            (separator-v)
            (bspwm-layout)
        )
        (box :space-evenly false :halign 'center')
        (box
            :space-evenly false
            :halign 'end'
            :css 'box { margin-right: .8em; }'
            (battery)
            (separator-v)
            (temp)
            (separator-v)
            (time)
        )
    )
)

;; -----------------------------------------------------------------------------

(deflisten bspwm-desktops :initial '[]' './scripts/bspwm-desktops.sh')
(defwidget bspwm-desktops []
    (box :class 'desktop'
        (for d in bspwm-desktops
            (button :onclick {d.command} :class {d.state} {d.icon})
        )
    )
)

(deflisten bspwm-layout :initial '?' './scripts/bspwm-layout.sh')
(defwidget bspwm-layout [] (button :onclick 'bspc desktop -l next' bspwm-layout))
