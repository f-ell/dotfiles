(defwidget separator-h [] (label :class 'separator hor' :text '─'))
(defwidget separator-v [] (label :class 'separator ver' :text '|'))

;; -----------------------------------------------------------------------------

(defwidget battery []
    (label
        :text '${EWW_BATTERY.BAT0.status == 'Charging' ? '+' : ''} ${round(EWW_BATTERY.total_avg, 0)}%'
    )
)

(defpoll temp :interval '2s' :initial 'CPU: ?°C' `temp.lt`)
(defwidget temp [] (label :text temp))

(defwidget time [] (label :text '${formattime(EWW_TIME, '%I:%M %p')}'))
(defwidget time-v []
    (box
        :orientation 'v'
        (label :text '${formattime(EWW_TIME, '%I')}')
        (label :text '${formattime(EWW_TIME, '%M')}')
    )
)
